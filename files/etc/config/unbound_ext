# Extension UCI for unbound clauses that live OUTSIDE the `server:`
# clause (forward-zone, view, stub, remote-control). Lines you set here
# are rendered into a managed region of /etc/unbound/unbound_ext.conf,
# which unbound auto-includes at the end of unbound.conf (after the
# server: clause has closed).
#
# Each `list ext_line` entry is emitted verbatim. To configure a whole
# clause (e.g. forward-zone:), supply one ext_line per line of the
# clause, in order. The generator does no clause-aware validation; trust
# unbound-checkconf to flag malformed output after the restart.
#
# For server-clause directives (interface:, outgoing-interface:,
# ip-transparent:, etc.), use /etc/config/unbound_srv instead.

config unbound_ext 'main'
	option enabled '0'

	# Example: a forward-zone for example.org going to 1.1.1.1.
	#list ext_line 'forward-zone:'
	#list ext_line '  name: "example.org"'
	#list ext_line '  forward-addr: 1.1.1.1'
	#list ext_line '  forward-addr: 1.0.0.1'

	# Example: a view named "internal" with a local zone.
	#list ext_line 'view:'
	#list ext_line '  name: "internal"'
	#list ext_line '  local-zone: "lan." static'
